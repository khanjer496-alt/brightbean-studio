{
  "swagger": "2.0",
  "info": {
    "title": "PostDelegate",
    "description": "Let your agent plan, draft, schedule and review social posts in PostDelegate.",
    "version": "1.0.0",
    "contact": {
      "email": "support@postdelegate.com"
    }
  },
  "host": "app.postdelegate.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
    "/api/v1/mcp": {
      "post": {
        "summary": "PostDelegate social scheduling server",
        "x-ms-agentic-protocol": "mcp-streamable-1.0",
        "operationId": "InvokeMCP",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "oauth2-auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://app.postdelegate.com/oauth/authorize/",
      "tokenUrl": "https://app.postdelegate.com/oauth/token/",
      "scopes": {
        "mcp": "Use PostDelegate tools on your behalf"
      }
    }
  },
  "security": [
    {
      "oauth2-auth": [
        "mcp"
      ]
    }
  ]
}
