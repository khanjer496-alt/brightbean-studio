# PostDelegate migration-spike configuration. Copy to .env only in the isolated
# BrightBean-based deployment; never commit real secrets.
SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_48
ENCRYPTION_KEY_SALT=GENERATE_WITH_OPENSSL_RAND_BASE64_48
DEBUG=false
ALLOWED_HOSTS=app.postdelegate.com
APP_URL=https://app.postdelegate.com
POSTDELEGATE_DOMAIN=app.postdelegate.com
POSTDELEGATE_HTTP_PORT=80
POSTDELEGATE_HTTPS_PORT=443

# Brand / legal identity
BRAND_NAME=PostDelegate
BRAND_SHORT_NAME=PostDelegate
BRAND_LEGAL_NAME=Nasida Apps LLC
BRAND_WEBSITE_URL=https://postdelegate.com
# Terms and Privacy are served by the app at /legal/terms/ and /legal/privacy/.
# Set these only to host the policies elsewhere.
# BRAND_TERMS_URL=
# BRAND_PRIVACY_URL=
LEGAL_ADDRESS=
LEGAL_EFFECTIVE_DATE=
BRAND_SUPPORT_EMAIL=support@postdelegate.com
BRAND_LOGO_STATIC=img/postdelegate-mark.svg
BRAND_FAVICON_STATIC=favicon/postdelegate.svg
BRAND_FAVICON_ICO_STATIC=favicon/postdelegate.ico
BRAND_APPLE_TOUCH_ICON_STATIC=favicon/postdelegate-apple-touch-icon.png
BRAND_MANIFEST_STATIC=favicon/postdelegate.webmanifest
MCP_SERVER_NAME=postdelegate
API_TOKEN_PREFIX=postdelegate_
# Public source of this AGPL-3.0 fork, linked from every page's credit.
SOURCE_CODE_URL=https://github.com/khanjer496-alt/brightbean-studio
# Sidebar review card; leave empty to keep it off.
REVIEW_BANNER_URL=

# Controlled beta: only invitations may create new accounts.
SIGNUP_MODE=invite

# Cloudflare -> Caddy -> app. Both hops must be trusted so each visitor gets
# their own login rate limit. Cloudflare's ranges: https://www.cloudflare.com/ips/
# (checked 23 Oct 2026). Caddy reads the space-separated list; the app reads
# the comma-separated one plus the Docker network range.
CADDY_TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
BB_TRUSTED_PROXIES=172.16.0.0/12,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# PostgreSQL on the same private Compose network.
POSTGRES_PASSWORD=GENERATE_URL_SAFE_DB_PASSWORD
DATABASE_URL=postgres://postdelegate:GENERATE_URL_SAFE_DB_PASSWORD@postgres:5432/postdelegate

# Cloudflare R2 (S3-compatible). Existing media bucket can be reused only after
# a bucket-scoped key is created. Keep the key values out of Git/repo settings.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=SET_BUCKET_SCOPED_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=SET_BUCKET_SCOPED_R2_SECRET_KEY
S3_BUCKET_NAME=nashr-production-media
# Keep private R2 signed URLs for the beta. A custom media domain is optional.
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto

# Free beta: authenticated transactional sender still needs to be configured.
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=PostDelegate <no-reply@postdelegate.com>

# AI writing assistant (composer): off until a key is set. Organizations can
# also bring their own key from Organization -> AI assistant.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Hosted Intelligence/paid AI remains off.
INTELLIGENCE_INTERNAL_URL=
INTELLIGENCE_PUBLIC_URL=
STUDIO_DEPLOYMENT_ID=
STUDIO_SHARED_SECRET=
STUDIO_BASE_URL=
UNSPLASH_ACCESS_KEY=

# Platform credentials intentionally empty until PostDelegate's own developer
# apps are approved. Customers never use BrightBean's credentials.
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
PLATFORM_THREADS_APP_ID=
PLATFORM_THREADS_APP_SECRET=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=

# PLANS & BILLING — set BILLING_ENABLED=true when paid plans launch. Create the Stripe Prices with
#   python manage.py billing_create_stripe_prices
# and paste the STRIPE_PRICE_* lines it prints. Webhook endpoint:
#   <APP_URL>/webhooks/stripe/
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
# BILLING_TRIAL_DAYS=14
# BILLING_GRACE_PERIOD_DAYS=7
