# CORE
# config.settings.production refuses to start with these placeholders (or any
# value under 32 characters). Generate each with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY_SALT=change-me-to-a-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000

# Who may create an account: open | invite | closed
#   open    anyone (default)
#   invite  only visitors who followed a valid invitation link
#   closed  nobody; create accounts in the Django admin
# A self-hosted install has to be reachable from the internet for OAuth
# callbacks and webhooks, so "open" means open to the world.
SIGNUP_MODE=open

# DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightbean

# STORAGE
STORAGE_BACKEND=local
# In the docker-compose deployment this has to stay /app/media: that is where
# the media_data volume is mounted, and where the Caddyfile's /media/ handler
# reads from. Point it elsewhere there and uploads 404 at the proxy.
MEDIA_ROOT=/app/media
# With STORAGE_BACKEND=local, Django serves MEDIA_ROOT at /media/, unauthenticated
# — that is required, because Instagram, Threads, Facebook, Pinterest, Google
# Business and dev.to fetch attachment URLs server-side when publishing. Set to
# false only when a reverse proxy or CDN serves MEDIA_ROOT on the same public
# path instead (the docker-compose.prod.yml + Caddyfile setup already does, so
# there the value is moot). Ignored entirely with STORAGE_BACKEND=s3.
SERVE_MEDIA=true
# Only the subtrees listed in PUBLIC_MEDIA_PREFIXES (config/urls.py) are
# reachable that way — media library assets, avatars and workspace icons.
# Comment attachments go through a permission-checked view instead.
#
# docker-compose only: where Caddy reads uploads from. Switch this to
# /var/empty when you move STORAGE_BACKEND to s3 — the media_data volume
# survives the change and Caddy cannot see SERVE_MEDIA, so it would otherwise
# keep serving the uploads left behind.
CADDY_MEDIA_ROOT=/app/media
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto
# Bytes an object may occupy in memory before the read spools to disk. Leave it
# alone unless you know why: django-storages' own default (0) means "never spool",
# which holds whole videos in RAM and is how a small dyno runs out of memory.
AWS_S3_MAX_MEMORY_SIZE=2097152

# EMAIL
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# GOOGLE AUTH (user login/signup - separate from platform credentials below)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Where "Sign up" links point, e.g. a waitlist page: an http(s):// URL or a
# path starting with /. Empty keeps the built-in /accounts/signup/. With
# SIGNUP_MODE=open that page stays open and is still used for invitees; with
# invite or closed, anyone who may not sign up (email form or Google) is
# redirected here instead.
CUSTOM_SIGNUP_URL=

# PLATFORM CREDENTIALS — set per deployment here (these take precedence), or
# per organization via the Django admin at /admin/ -> Platform credentials.
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
# Optional but recommended for agency/multi-business onboarding.
PLATFORM_FACEBOOK_CONFIG_ID=
# Instagram via Facebook Login requests messaging permissions by default.
# Set false if your Meta app cannot request instagram_manage_messages yet.
# pages_manage_metadata is requested in both states. Existing DM grants keep working.
PLATFORM_INSTAGRAM_FACEBOOK_DM_SCOPES_ENABLED=true
# Enable only after Meta approves Human Agent access (seven-day human support).
PLATFORM_FACEBOOK_HUMAN_AGENT_ENABLED=false
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
PLATFORM_INSTAGRAM_HUMAN_AGENT_ENABLED=false
# Threads - NOT the Facebook App ID. A Meta app with the "Access the Threads API"
# use case gets its own pair, shown as "Threads App ID" / "Threads App Secret"
# under App settings -> Basic. Threads stays unconfigured until both are set.
PLATFORM_THREADS_APP_ID=
PLATFORM_THREADS_APP_SECRET=
# LinkedIn - see README "LinkedIn" section. Choose Path A or Path B (or both).
# Path B (Community Management API) credentials are automatically reused for
# personal connections, giving refresh tokens + inbox.
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
# Legacy shared vars (still honored as fallback for both personal + company,
# assumed to be CM-approved). Leave commented unless migrating from an older install.
# PLATFORM_LINKEDIN_CLIENT_ID=
# PLATFORM_LINKEDIN_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=

# Enable after reviewing staging youtube_compliance_report counts and worker execution.
# Explicit YouTube deletion/revoked-grant cleanup runs regardless of this gate.
YOUTUBE_COMPLIANCE_ENFORCEMENT=false
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=

# TELEGRAM - one bot posts to every connected channel or group. Create it with
# @BotFather and paste its token; users add the bot as an administrator of their
# chat. Leave empty to hide Telegram on the connect page.
PLATFORM_TELEGRAM_BOT_TOKEN=

# DISCORD - one application with a bot. Create it at
# https://discord.com/developers/applications, add the OAuth2 redirect
# https://<your-domain>/social-accounts/callback/discord/ and paste the values.
# Leave empty to hide Discord on the connect page.
PLATFORM_DISCORD_CLIENT_ID=
PLATFORM_DISCORD_CLIENT_SECRET=
PLATFORM_DISCORD_BOT_TOKEN=

# SLACK - one app installed per workspace by the user. Create it at
# https://api.slack.com/apps, add the bot scopes chat:write, files:write,
# channels:read and groups:read, the redirect
# https://<your-domain>/social-accounts/callback/slack/, and keep token rotation OFF.
# Leave empty to hide Slack on the connect page.
PLATFORM_SLACK_CLIENT_ID=
PLATFORM_SLACK_CLIENT_SECRET=

# REDDIT - a "web app" created at https://www.reddit.com/prefs/apps with the
# redirect https://<your-domain>/social-accounts/callback/reddit/. Optionally set
# the User-Agent Reddit's API rules ask for: web:<app id>:<version> (by /u/<your username>)
# Leave the client id empty to hide Reddit on the connect page.
PLATFORM_REDDIT_CLIENT_ID=
PLATFORM_REDDIT_CLIENT_SECRET=
PLATFORM_REDDIT_USER_AGENT=

# UNSPLASH — optional; enables stock-photo search in the composer.
# Create a free app at https://unsplash.com/developers and paste its Access Key.
UNSPLASH_ACCESS_KEY=

# PUBLISHING
# Seconds a post may sit mid-publish before the confirmation sweep gives up on
# it. STALE covers a post whose worker died before reaching the platform;
# CONFIRM covers one the platform accepted and is still processing (TikTok
# transcodes after upload). Both end as a visible failure, never a silent retry.
PUBLISHER_STALE_PUBLISHING_TIMEOUT=900
PUBLISHER_PUBLISH_CONFIRM_TIMEOUT=1800
# And how long to keep retrying when the platform accepted the upload but we
# cannot reach it to ask the outcome. Much longer, because the post may already
# be live: every extra retry is a chance to learn that instead of warning the
# user about a duplicate we could have ruled out.
PUBLISHER_UNCONFIRMED_TIMEOUT=21600
# Publisher concurrency. PUBLISHES caps rows per cycle and costs nothing; the
# other two are a Postgres connection budget, not a throughput knob, because
# each publish thread holds its own connection. Keep POSTS + PLATFORM_PUBLISHES
# + the web dyno's gunicorn threads under the connection limit of your Postgres
# plan (20 for the whole role on Heroku essential-0). To pause publishing use
# `heroku ps:scale worker=0`, not a 0 here — these floor at 1.
PUBLISHER_MAX_CONCURRENT_PUBLISHES=10
PUBLISHER_MAX_CONCURRENT_POSTS=4
PUBLISHER_MAX_CONCURRENT_PLATFORM_PUBLISHES=6

# MONITORING
# Sentry performance sampling. Profiling is off by default - it keeps stack
# samples in memory, which a 512 MB dyno cannot spare.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# INBOUND WEBHOOKS
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=

# AI WRITING ASSISTANT — optional. Every AI feature runs on an organization's
# own AI connection (its own key under Organization → AI). To share one
# platform key with every organization instead, set ANTHROPIC_API_KEY and
# AI_PLATFORM_KEY_FOR_CUSTOMERS=true. AI_MODEL defaults to Claude Opus 5.5.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
AI_PLATFORM_KEY_FOR_CUSTOMERS=false
# AI_REQUEST_TIMEOUT=45
# Daily safety cap on requests made with an organization's own key.
# AI_ORGANIZATION_KEY_DAILY_CAP=10000

# INTELLIGENCE — optional hosted SaaS integration.
# All five vars must be set for the Intelligence menu item / billing flow
# to appear. Leave any blank to keep Studio in vanilla OSS mode (no Stripe,
# no left-nav Intelligence entry, no /orgs/<id>/intelligence/ URLs).
# - INTELLIGENCE_INTERNAL_URL: hosted Intelligence's /internal/v1/ base
# - INTELLIGENCE_PUBLIC_URL:   hosted Intelligence's /v1/ base
# - STUDIO_DEPLOYMENT_ID:      must match the value registered on the
#                              Intelligence side via register_studio_deployment
# - STUDIO_SHARED_SECRET:      HMAC secret for this deployment (Intelligence-issued)
# - STUDIO_BASE_URL:           https:// URL of THIS Studio deployment.
#                              Validated at boot — non-https raises
#                              ImproperlyConfigured.
INTELLIGENCE_INTERNAL_URL=
INTELLIGENCE_PUBLIC_URL=
STUDIO_DEPLOYMENT_ID=
STUDIO_SHARED_SECRET=
STUDIO_BASE_URL=

# MCP OAUTH — optional. The /api/v1/mcp endpoint accepts a native OAuth login
# (e.g. Claude Desktop → "Add custom connector") in addition to bb_studio_ API
# keys. Both URLs default to APP_URL; set them only for a split app/api
# deployment. In production they must be the public https origin Claude reaches.
# MCP_PUBLIC_BASE_URL=https://your-studio.example.com
# MCP_OAUTH_ISSUER_URL=https://your-studio.example.com

# PLANS & BILLING — off for self-hosted installs (everything unlimited, no
# billing UI). Create the Stripe Prices with
#   python manage.py billing_create_stripe_prices
# and paste the STRIPE_PRICE_* lines it prints. Webhook endpoint:
#   <APP_URL>/webhooks/stripe/
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Starter $19/mo, Team $29/mo, Pro $39/mo, Ultimate $79/mo; yearly is 20% off
# ($180, $276, $372, $756 a year). Plan limits live in apps/billing/plans.py.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ULTIMATE_MONTHLY=
STRIPE_PRICE_ULTIMATE_ANNUAL=
# New organizations trial Ultimate for this many days, no card; then Free.
# BILLING_TRIAL_DAYS=14
# BILLING_GRACE_PERIOD_DAYS=7
