---
// Coloured logo tile. Simple Icons (CC0) glyph where one exists, initials tile otherwise.
import type { Network } from '../data/networks';
import meta from '../data/icon-meta.json';
import Icon from './Icon.astro';
interface Props { n: Network; size?: 'sm' | 'md' | 'lg' }
const { n, size = 'md' } = Astro.props;
const dim = { sm: 'size-8 rounded-lg text-[11px]', md: 'size-10 rounded-[10px] text-xs', lg: 'size-12 rounded-xl text-sm' }[size];
const glyph = { sm: 'size-4', md: 'size-5', lg: 'size-6' }[size];
const hex = (meta as Record<string, string>)[n.key];
const lum = (h: string) => { const c = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4)); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
let bg = hex ?? n.color, fg = '#fff';
if (hex && lum(hex) < 0.05) { bg = '#ffffff'; fg = '#0a0a0f'; }
else if (!hex) { const L = lum(n.color); if ((L + 0.05) / 0.05 > 1.05 / (L + 0.05)) fg = '#0a0a0f'; }
---
<span aria-hidden="true" class={`inline-flex shrink-0 items-center justify-center font-extrabold ${dim}`} style={`background:${bg};color:${fg}`}>{hex ? <Icon name={n.key} class={glyph} /> : n.abbr}</span>
