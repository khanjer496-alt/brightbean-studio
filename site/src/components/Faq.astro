---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface-1">
  {items.map((f) => (
    <details class="group">
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-5 text-left text-base font-bold transition hover:bg-white/[.02] sm:px-6">
        <span>{f.q}</span>
        <svg class="chev size-5 shrink-0 text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="px-5 pb-6 text-ink-2 leading-relaxed sm:px-6" set:html={f.a} />
    </details>
  ))}
</div>
