---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="space-y-3">
  {items.map((f) => (
    <details class="group overflow-hidden rounded-2xl border border-line bg-surface-1 transition open:border-brand/50">
      <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left text-base font-bold transition hover:bg-white/[.03] sm:px-6">
        <span>{f.q}</span>
        <svg class="chev size-5 shrink-0 text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="px-5 pb-6 leading-relaxed text-ink-2 sm:px-6" set:html={f.a} />
    </details>
  ))}
</div>
